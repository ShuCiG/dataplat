# Copy to .env (not tracked) and fill in. Nothing here is a secret: the Snowflake login uses the
# AWS role, and AWS credentials come from the mounted ~/.aws profile.

# Which environment this Airflow drives. Everything else is read from SSM for that environment.
PLATFORM_ENV=dev

# Profile in ~/.aws/config that assumes dataplat-<env>-airflow-orchestrator.
AWS_PROFILE=dataplat-dev-orchestrator

# Snowflake account, as organisation and account name.
SNOWFLAKE_ORGANIZATION_NAME=
SNOWFLAKE_ACCOUNT_NAME=

# Where ~/.aws is on this machine (Windows: C:/Users/<you>/.aws).
AWS_CONFIG_DIR=~/.aws

# AWS region of the platform (the Snowflake connector needs it in the environment).
AWS_REGION=eu-central-1
